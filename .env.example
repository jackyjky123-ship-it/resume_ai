# ResumeAI — server-only environment variables.
# Copy to .env.local for local development (`neon deploy` / `neon env pull`
# writes the Neon-managed values automatically). Never commit real values.

# ── Neon-managed (written by `neon env pull`) ────────────────────────────────
# Note: sslmode=verify-full ensures strict TLS verification and prevents node-postgres warnings.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=verify-full"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=verify-full"
NEON_BRANCH="production"
NEON_AUTH_BASE_URL="https://example-managed-auth-url.neon.tech/auth"
NEON_AUTH_JWKS_URL="https://example-managed-auth-url.neon.tech/auth/.well-known/jwks.json"
NEON_FUNCTION_HELLO_BASE_URL="https://branch-hello.compute.cell.us-east-2.aws.neon.tech"

# ── App-generated (not injected by Neon) ────────────────────────────────────
# Next-side secret for cached Neon Auth session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEON_AUTH_COOKIE_SECRET="replace-with-a-long-random-secret"

# ── AI Service (BYOK: Bring Your Own Key) ──────────────────────────────────
# No server-side GEMINI_API_KEY is required! Users provide their own free Google
# AI Studio key directly in the web UI. Keys are stored in the user's browser
# localStorage and sent transiently to Gemini. No database storage or logging.
