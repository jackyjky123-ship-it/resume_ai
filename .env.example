# Placeholders only. Copy this file to .env for local development and fill in real values.
# Never commit .env. All values below are server-only secrets — never expose them to the
# client bundle or prefix them with NEXT_PUBLIC_ (PLAN.md §12, §16).

# Phase 2 — Neon PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Phase 3 — Auth.js secret; use a long random value
AUTH_SECRET="replace-with-a-long-random-secret"

# Phase 5 — Gemini API key (free tier AI suggestions)
GEMINI_API_KEY="replace-with-your-provider-key"
